          {
            "group": "Compañía",
            "pages": [
              "company/about",
              "company/cv",
              "company/standards",
              "company/brands",
              "company/contact"
            ]
          },
          {
            "group": "Productos",
            "pages": [
              "products/ark-os-lite",
              "products/solutions"
            ]
          },
          {
            "group": "ARK DEV System",
            "pages": [
              "services/system",
              "services/ai",
              "services/infrastructure",
              "services/stack"
            ]
          },
          {
