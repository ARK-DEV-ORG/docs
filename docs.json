{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "sequoia",
  "name": "ARK DEV DOCS",
  "colors": {
    "primary": "#0EA5A8",
    "light": "#7CFFE4",
    "dark": "#0B3F3A"
  },
  "favicon": "/favicon.svg",
  "appearance": {
    "default": "dark",
    "strict": true
  },
  "description": "Documentación oficial de ARK DEV. Consultora tecnológica enterprise en Latinoamérica: software, IA multi-modelo, Oracle Cloud, ecosistema Google, ciberseguridad, infraestructura cloud y hardware/IoT.",
  "seo": {
    "indexing": "all",
    "metatags": {
      "canonical": "https://docs.ark-dev.org",
      "robots": "index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1",
      "googlebot": "index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1",
      "bingbot": "index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1",
      "og:site_name": "ARK DEV Docs",
      "og:type": "website",
      "og:title": "ARK DEV Docs | Documentación Técnica Enterprise",
      "og:locale": "es_LA",
      "keywords": "ARK DEV, consultora tecnológica, software enterprise, Oracle Cloud, Google ecosystem, Universal Cart, IA multi-modelo, Anthropic, OpenAI, xAI Grok, Gemma 4, ciberseguridad, DevOps, cloud, infraestructura VPS, documentación técnica",
      "og:image": "https://docs.ark-dev.org/images/hero-dark.png",
      "og:image:alt": "ARK DEV Docs",
      "twitter:card": "summary_large_image",
      "twitter:title": "ARK DEV Docs | Documentación Técnica Enterprise",
      "twitter:image": "https://docs.ark-dev.org/images/hero-dark.png",
      "twitter:image:alt": "ARK DEV Docs"
    }
  },
  "search": {
    "prompt": "Buscar en la documentación..."
  },
  "fonts": {
    "heading": {
      "family": "Sora"
    },
    "body": {
      "family": "Inter"
    }
  },
  "icons": {
    "library": "lucide"
  },
  "background": {
    "decoration": "gradient"
  },
  "styling": {
    "codeblocks": "dark"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "General",
        "groups": [
          {
